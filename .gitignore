# Godot editor/import/cache output
godot_remake/.godot/
godot_remake/_playdata/

# Release binaries and derived manifest/checksums are generated by
# work/v155/rebuild_release.py and stay out of Git. The release *documents*
# (交付报告 / 已知问题 / 试玩验收清单) are content and ARE tracked, otherwise
# docs/doc_gate.py and test_release_candidate_scene cannot run on a fresh clone.
godot_remake/artifacts/releases/**/*.exe
godot_remake/artifacts/releases/**/*.pck
godot_remake/artifacts/releases/**/SHA256SUMS.txt
godot_remake/artifacts/releases/**/build_manifest.json

# Single-file playable build (tools/build_playable.ps1); binaries never enter Git
godot_remake/artifacts/playable/

# Local audit/tool downloads and generated work files
godot_remake/work/
godot_remake/tests/artifacts/

# Local run logs
godot_remake/*.log
godot_remake/**/*.log

# Workspace scratch, backups, and local diagnostics
backup/
tmp/
work/
tests/tmp_*

# Original SWF inputs are kept outside the source repository
魔域1.03_v*.swf

# Local Python/tool caches
__pycache__/
*.pyc
