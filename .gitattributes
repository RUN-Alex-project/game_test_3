# 跨平台行尾规范化：文本按 LF 入库；PowerShell 保持 CRLF（Windows 既有习惯）。
# 注意：本文件仅影响后续新增/修改文件的入库规范化，不做全仓库重规范化。
* text=auto

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.md text eol=lf

*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.exe binary
*.pck binary
*.zip binary
